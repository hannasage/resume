# Which blog content backend to use: "local" (default) or "sanity".
BLOG_CONTENT_SOURCE=local

# Site identifier used to filter which blog posts this deployment shows.
# Defaults to hannasage.love when unset.
NEXT_PUBLIC_SITE_ID=hannasage.love

# Sanity project id. Only read when BLOG_CONTENT_SOURCE=sanity. Placeholder, not a real value.
SANITY_PROJECT_ID=your-project-id-here

# Sanity dataset name (e.g. "production"). Only read when BLOG_CONTENT_SOURCE=sanity.
SANITY_DATASET=your-dataset-name-here

# Sanity API token with read access. Only read when BLOG_CONTENT_SOURCE=sanity. Never a real key here.
SANITY_API_TOKEN=your-api-token-here

# Sanity API version date (e.g. "2024-01-01"). Only read when BLOG_CONTENT_SOURCE=sanity.
SANITY_API_VERSION=your-api-version-here

# Server-only flag. Set to "1" to unlock /scroll-world-preview in production.
# Unset (the default) means the route returns 404 in production. Never a
# NEXT_PUBLIC_ variable: the check runs server-side only.
SCROLL_WORLD_PREVIEW=
